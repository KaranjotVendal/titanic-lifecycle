# Titanic Survival API — self-contained image.
# Build:  docker build -t titanic .
# Run:    docker run -p 8000:8000 titanic
# Test:   curl -X POST localhost:8000/predict -H "Content-Type: application/json" -d '<passenger json>'

FROM python:3.13-slim

# uv, pinned to match the project's build-system requirement
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /usr/local/bin/uv

WORKDIR /app

# 1) dependency layer first: only rebuilds when pyproject/uv.lock change
#    (README.md is referenced by pyproject, so it belongs here)
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

# 2) code layer: rebuilds only when src/ changes
COPY src ./src
RUN uv sync --frozen --no-dev

# 3) the champion brain (trained artifact, regenerated by `titanic.train`)
COPY models/champion.joblib ./models/champion.joblib

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "titanic.serve:app", "--host", "0.0.0.0", "--port", "8000"]
